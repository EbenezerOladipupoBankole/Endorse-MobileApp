rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // email_verified: anyone can create an unverified password account for any address.
    function isAdmin() {
      return isSignedIn() && request.auth.token.email_verified == true && request.auth.token.email in
        ['bankoleebenezer111@gmail.com', 'omakaoe@gmail.com', 'ayindeenny112@gmail.com'];
    }

    function isWhatsAppSigner(docId) {
      return isSignedIn() && request.auth.uid == ('whatsapp-signer-' + docId);
    }

    function isTeamMember(teamId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid));
    }

    // Fields that must never be settable directly by a client — they are only
    // ever written by trusted server code (Cloud Functions using the Admin SDK,
    // which bypasses these rules entirely).
    function touchesProtectedUserFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['plan', 'stripeCustomerId', 'teamId']);
    }

    match /users/{userId} {
      allow read: if isSelf(userId) || isAdmin();
      allow create: if isSelf(userId) &&
        !request.resource.data.keys().hasAny(['plan', 'stripeCustomerId', 'teamId']);
      allow update: if isAdmin() || (isSelf(userId) && !touchesProtectedUserFields());
      allow delete: if false;
    }

    match /documents/{docId} {
      allow read, update: if isSignedIn() &&
        (isAdmin() || isWhatsAppSigner(docId) || request.auth.token.email == resource.data.ownerEmail);
      allow create: if isSignedIn() &&
        request.auth.token.email == request.resource.data.ownerEmail;
      allow delete: if isSignedIn() &&
        (isAdmin() || request.auth.token.email == resource.data.ownerEmail);
    }

    match /notifications/{notifId} {
      allow read, update, delete: if isSignedIn() && request.auth.token.email == resource.data.recipientEmail;
      allow create: if isSignedIn();
    }

    match /invites/{inviteId} {
      allow read: if isSignedIn() &&
        (isAdmin() || request.auth.token.email == resource.data.toEmail ||
         request.auth.token.email == resource.data.invitedBy || isTeamMember(resource.data.teamId));
      allow create: if isSignedIn() && request.auth.token.email == request.resource.data.invitedBy;
      // Status transitions (accept/expire) are only performed server-side via
      // the acceptTeamInvite Cloud Function, which uses the Admin SDK.
      allow update: if false;
      allow delete: if isSignedIn() &&
        (isAdmin() || request.auth.token.email == resource.data.invitedBy);
    }

    match /teams/{teamId} {
      allow read: if isAdmin() || isTeamMember(teamId);
      // Team documents are only created/modified server-side (createTeam,
      // removeTeamMember, acceptTeamInvite Cloud Functions).
      allow write: if false;

      match /members/{memberId} {
        allow read: if isAdmin() || isTeamMember(teamId);
        allow write: if false;
      }
    }

    match /audit_logs/{logId} {
      allow read: if isSignedIn() &&
        (isAdmin() ||
         get(/databases/$(database)/documents/documents/$(resource.data.documentId)).data.ownerEmail == request.auth.token.email);
      // Audit entries are only ever written by trusted server-side logic.
      allow write: if false;
    }

    match /blogs/{blogId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /tutorials/{tutorialId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Server-only collections — never touched by client SDKs, only by Cloud
    // Functions via the Admin SDK (which bypasses these rules entirely).
    match /whatsapp_otps/{docId} {
      allow read, write: if false;
    }

    // ───────────────── Mobile app additions ─────────────────
    // Everything above is the web app's ruleset, unchanged. The mobile app
    // uses its own collections below, so it never reads or writes web data
    // (users/{uid} profiles are shared and covered by the rule above).

    function isOwnerById(data) {
      return isSignedIn() && data.ownerId == request.auth.uid;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    // A signer listed on a mobile document by verified email (recipientEmails).
    function isVerifiedRecipient(data) {
      return isVerified() && myEmail() in data.recipientEmails;
    }

    // Client-supplied epoch-ms timestamps must be within 10 minutes of the server clock.
    function isRecent(ms) {
      return ms is number && math.abs(ms - request.time.toMillis()) < 600000;
    }

    // fileUri may only point at the owner's folder in our Storage bucket, or at a
    // file left on the sender's device (upload fallback; never loaded for recipients).
    function validFileUri(data) {
      return !('fileUri' in data)
        || data.fileUri.matches('^https://firebasestorage[.]googleapis[.]com/v0/b/endorse-app[.]firebasestorage[.]app/o/documents%2F' + data.ownerId + '%2F.*')
        || data.fileUri.matches('^(file|content)://.*');
    }

    // Written only by the mobile Cloud Functions (functions/src/index.ts).
    function touchesServerFields(data) {
      return data.keys().hasAny(['sealedAt', 'fileSha256', 'bodySha256', 'completedAt']);
    }

    // Sender identity is taken from the auth token, never from the client. A new
    // envelope is a draft, a sent envelope (sealed by mobileSealDocument), or the
    // sender's own upload that they signed themselves.
    function validNewDocument(data) {
      return isOwnerById(data)
        && data.ownerEmail == request.auth.token.email
        && data.sender.id == request.auth.uid
        && data.sender.email == myEmail()
        && validFileUri(data)
        && !touchesServerFields(data)
        && isRecent(data.createdAt)
        && (data.status == 'draft'
          || (isVerified()
            && (data.status == 'waiting_on_others'
              || (data.status == 'completed' && data.signers.size() == 1 && data.signers[0].email == myEmail()))));
    }

    // Only drafts are client-editable. Sending (draft -> waiting_on_others) needs a
    // verified email; after that every change goes through the Cloud Functions.
    function isDraftUpdate() {
      let before = resource.data;
      let after = request.resource.data;
      return isOwnerById(before)
        && before.status == 'draft'
        && after.ownerId == before.ownerId
        && after.ownerEmail == before.ownerEmail
        && after.sender == before.sender
        && validFileUri(after)
        && !touchesServerFields(after)
        && (after.status == 'draft' || (after.status == 'waiting_on_others' && isVerified()));
    }

    // Signature envelopes created in the mobile app. Signing, declining, viewing,
    // reminders and voiding are Cloud Functions (mobileSignDocument etc.).
    match /mobile_documents/{docId} {
      allow read: if isOwnerById(resource.data) || isVerifiedRecipient(resource.data);
      allow create: if validNewDocument(request.resource.data);
      allow update: if isDraftUpdate();
      allow delete: if isOwnerById(resource.data);
    }

    // Per-user templates, invoices and saved invoice clients. ownerId can't be reassigned.
    match /templates/{id} {
      allow read, delete: if isOwnerById(resource.data);
      allow update: if isOwnerById(resource.data) && request.resource.data.ownerId == resource.data.ownerId;
      allow create: if isOwnerById(request.resource.data);
    }
    match /invoices/{id} {
      allow read, delete: if isOwnerById(resource.data);
      allow update: if isOwnerById(resource.data) && request.resource.data.ownerId == resource.data.ownerId;
      allow create: if isOwnerById(request.resource.data);
    }
    // Client ids are `${ownerId}_${email}`; only the owner may claim their own prefix.
    match /clients/{id} {
      allow read, delete: if isOwnerById(resource.data);
      allow update: if isOwnerById(resource.data) && request.resource.data.ownerId == resource.data.ownerId;
      allow create: if isOwnerById(request.resource.data) && id.matches(request.auth.uid + '_.*');
    }
    // ─────────────── End of mobile app additions ───────────────

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
